# Copy this file to .env and tune it for your setup.

# Clap detector
JARVIS_SAMPLE_RATE=44100
JARVIS_BLOCK_MS=40
JARVIS_SPIKE_RATIO=7.0
JARVIS_COOLDOWN_S=0.45
JARVIS_MIN_DOUBLE_GAP_S=0.05
JARVIS_MAX_DOUBLE_GAP_S=0.35
JARVIS_MIN_RMS=0.012

# Safety/testing
JARVIS_DRY_RUN=false

# Startup actions triggered by double clap
JARVIS_PLAY_STARTUP_URI=false
JARVIS_STARTUP_URI=https://open.spotify.com/
JARVIS_OPEN_CLAUDE=true
JARVIS_CLAUDE_URL=https://claude.ai/new
JARVIS_OPEN_CURSOR=true
JARVIS_CURSOR_NEW_WINDOW=false

# Optional JARVIS welcome/answer speech
JARVIS_SPEECH_ENABLED=true
JARVIS_SPEAK_ONCE=true
JARVIS_SPEECH_DELAY_S=1.0
JARVIS_WELCOME_PHRASE=Welcome home sir. Systems are online.
JARVIS_SPEECH_CACHE_ENABLED=true
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
ELEVENLABS_PCM_SAMPLE_RATE=24000

# Conversation mode: clap, ask a question, get a spoken AI answer
JARVIS_CONVERSATION_ENABLED=true
JARVIS_LISTEN_SECONDS=7.0
JARVIS_PRE_LISTEN_DELAY_S=0.4
JARVIS_TRANSCRIBE_PROVIDER=openai
JARVIS_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
JARVIS_AI_MODE=auto
JARVIS_MAX_RESPONSE_CHARS=900
JARVIS_SYSTEM_PROMPT=You are JARVIS: calm, capable, precise, lightly witty, and useful. Answer like a loyal desktop assistant. Keep replies brief unless detail is needed.

# AI providers. Auto mode chooses between whichever providers have keys/config.
OPENAI_API_KEY=
JARVIS_OPENAI_MODEL=gpt-5.5-mini
ANTHROPIC_API_KEY=
JARVIS_ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_API_KEY=
JARVIS_GEMINI_MODEL=gemini-3.5-flash
JARVIS_OLLAMA_ENABLED=false
JARVIS_OLLAMA_URL=http://localhost:11434/api/chat
JARVIS_OLLAMA_MODEL=llama3.2

# Off by default. Do not enable this unless you actually want it opening.
JARVIS_OPEN_BINANCE=false
JARVIS_BINANCE_URL=https://www.binance.com/en/trade/BTC_USDT
