# Copy this file to .env and tune it for your setup.

# Clap detector
JARVIS_SAMPLE_RATE=44100
JARVIS_BLOCK_MS=40
JARVIS_SPIKE_RATIO=7.0
JARVIS_COOLDOWN_S=0.45
JARVIS_MIN_DOUBLE_GAP_S=0.05
JARVIS_MAX_DOUBLE_GAP_S=0.35
JARVIS_MIN_RMS=0.012

# Safety/testing
JARVIS_DRY_RUN=false

# Startup actions triggered by double clap
JARVIS_PLAY_STARTUP_URI=false
JARVIS_STARTUP_URI=https://open.spotify.com/
JARVIS_OPEN_CLAUDE=true
JARVIS_CLAUDE_URL=https://claude.ai/new
JARVIS_OPEN_CURSOR=true
JARVIS_CURSOR_NEW_WINDOW=false

# Optional JARVIS welcome/answer speech
JARVIS_SPEECH_ENABLED=true
JARVIS_WELCOME_ENABLED=false
JARVIS_WELCOME_BEFORE_CONVERSATION=false
JARVIS_SPEAK_ONCE=true
JARVIS_SPEECH_DELAY_S=0.0
JARVIS_WELCOME_PHRASE=Welcome home sir. Systems are online.
JARVIS_SPEECH_CACHE_ENABLED=true
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
ELEVENLABS_PCM_SAMPLE_RATE=24000

# Conversation mode: double clap, say "hey Jarvis", ask a question, get a spoken AI answer
JARVIS_CONVERSATION_ENABLED=true
JARVIS_LISTEN_SECONDS=7.0
JARVIS_PRE_LISTEN_DELAY_S=0.15
JARVIS_VAD_ENABLED=true
JARVIS_VAD_MIN_RECORD_S=0.75
JARVIS_VAD_SILENCE_S=0.85
JARVIS_VAD_START_RMS=0.010
JARVIS_VAD_STOP_RMS=0.006

# Wake phrase after the clap. "hey javis" is included to match the current spelling too.
JARVIS_WAKE_AFTER_CLAP_ENABLED=true
JARVIS_WAKE_LISTEN_SECONDS=3.0
JARVIS_WAKE_RETRIES=1
JARVIS_WAKE_PHRASES=hey jarvis,hey javis
JARVIS_WAKE_USE_REMAINDER_AS_QUESTION=true

JARVIS_TRANSCRIBE_PROVIDER=openai
JARVIS_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
JARVIS_AI_MODE=auto
JARVIS_MAX_RESPONSE_CHARS=900
JARVIS_SYSTEM_PROMPT=You are JARVIS: calm, capable, precise, lightly witty, and useful. Answer like a loyal desktop assistant. Keep replies brief unless detail is needed.

# AI providers. Auto mode chooses between whichever providers have keys/config.
OPENAI_API_KEY=
JARVIS_OPENAI_MODEL=auto
JARVIS_OPENAI_MODEL_PREFERENCES=gpt-5.5,gpt-5.5-instant,gpt-5.4-mini,gpt-5.4,gpt-5,gpt-4.1-mini,gpt-4o-mini
ANTHROPIC_API_KEY=
JARVIS_ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_API_KEY=
JARVIS_GEMINI_MODEL=gemini-3.5-flash
JARVIS_OLLAMA_ENABLED=false
JARVIS_OLLAMA_URL=http://localhost:11434/api/chat
JARVIS_OLLAMA_MODEL=llama3.2

# Operator mode: screen control after "hey Jarvis"
JARVIS_OPERATOR_ENABLED=true
JARVIS_OPERATOR_SCREENSHOT_ENABLED=true
JARVIS_OPERATOR_DESCRIBE_SCREEN_ENABLED=true
JARVIS_OPERATOR_ALLOW_OPEN_APPS=true
JARVIS_OPERATOR_ALLOW_URLS=true
JARVIS_OPERATOR_ALLOW_MOUSE=false
JARVIS_OPERATOR_ALLOW_KEYBOARD=false
JARVIS_OPERATOR_ALLOW_TYPING=false
JARVIS_OPERATOR_SCREENSHOT_DIR=
JARVIS_OPENAI_VISION_MODEL=auto
JARVIS_OPERATOR_MAX_DESCRIPTION_CHARS=700
JARVIS_OPERATOR_ALLOWED_APPS=cursor,chrome,notepad,calculator,explorer,cmd,powershell

# Off by default. Do not enable this unless you actually want it opening.
JARVIS_OPEN_BINANCE=false
JARVIS_BINANCE_URL=https://www.binance.com/en/trade/BTC_USDT
