# Copy this file to .env and tune it for your setup.

# Clap detector
JARVIS_SAMPLE_RATE=44100
JARVIS_BLOCK_MS=40
JARVIS_SPIKE_RATIO=7.0
JARVIS_COOLDOWN_S=0.45
JARVIS_MIN_DOUBLE_GAP_S=0.05
JARVIS_MAX_DOUBLE_GAP_S=0.35
JARVIS_MIN_RMS=0.012

# Safety/testing
JARVIS_DRY_RUN=false

# Startup actions triggered by double clap
JARVIS_PLAY_STARTUP_URI=false
JARVIS_STARTUP_URI=https://open.spotify.com/
JARVIS_OPEN_CLAUDE=true
JARVIS_CLAUDE_URL=https://claude.ai/new
JARVIS_OPEN_CURSOR=true
JARVIS_CURSOR_NEW_WINDOW=false

# Off by default. Do not enable this unless you actually want it opening.
JARVIS_OPEN_BINANCE=false
JARVIS_BINANCE_URL=https://www.binance.com/en/trade/BTC_USDT
